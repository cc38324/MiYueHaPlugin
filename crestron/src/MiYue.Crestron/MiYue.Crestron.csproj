<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SIMPL# library for Crestron 4-series (.NET Framework 4.7.2). The Crestron SDK package's build targets
    zip the output into bin/<Configuration>/net472/MiYue.Crestron.clz - that .clz is what SIMPL+ loads with
      #USER_SIMPLSHARP_LIBRARY "MiYue.Crestron"

    The pure logic lives in ../MiYue.Core (netstandard2.0, unit-tested with `dotnet test`). Its sources are
    compiled INTO this assembly (linked, not referenced) so the .clz carries one self-contained
    MiYue.Crestron.dll: no netstandard facade assemblies have to resolve on the processor's runtime.
    Only the Crestron-specific adapter code lives in this folder.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>MiYue.Crestron</RootNamespace>
    <AssemblyName>MiYue.Crestron</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);CRESTRON</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.21.274" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MiYue.Core\**\*.cs" Exclude="..\MiYue.Core\obj\**;..\MiYue.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

</Project>
