<?xml version="1.0" encoding="utf-8"?>
<scpd xmlns="urn:schemas-upnp-org:service-1-0">
  <specVersion><major>1</major><minor>0</minor></specVersion>
  <actionList>
    <action>
      <name>ListAccounts</name>
      <argumentList>
        <argument><name>Accounts</name><direction>out</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>GetCookies</name>
      <argumentList>
        <argument><name>SourceId</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>Cookies</name><direction>out</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>AccountLabel</name><direction>out</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>SetCookies</name>
      <argumentList>
        <argument><name>SourceId</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>AccountLabel</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>Cookies</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>WriterUdn</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>Logout</name>
      <argumentList>
        <argument><name>SourceId</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>WriterUdn</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
  </actionList>
  <serviceStateTable>
    <stateVariable sendEvents="yes"><name>LastChange</name><dataType>string</dataType></stateVariable>
    <stateVariable sendEvents="no"><name>A_ARG_Str</name><dataType>string</dataType></stateVariable>
  </serviceStateTable>
</scpd>
