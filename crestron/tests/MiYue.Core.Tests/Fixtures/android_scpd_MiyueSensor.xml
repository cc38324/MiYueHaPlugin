<?xml version="1.0" encoding="utf-8"?>
<scpd xmlns="urn:schemas-upnp-org:service-1-0">
  <specVersion><major>1</major><minor>0</minor></specVersion>
  <actionList>
    <action>
      <name>ListSensors</name>
      <argumentList>
        <argument><name>Sensors</name><direction>out</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>ExecuteSensor</name>
      <argumentList>
        <argument><name>SensorId</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>CreateSensor</name>
      <argumentList>
        <argument><name>Json</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
        <argument><name>NewSensorId</name><direction>out</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>UpdateSensor</name>
      <argumentList>
        <argument><name>Json</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
    <action>
      <name>DeleteSensor</name>
      <argumentList>
        <argument><name>SensorId</name><direction>in</direction><relatedStateVariable>A_ARG_Str</relatedStateVariable></argument>
      </argumentList>
    </action>
  </actionList>
  <serviceStateTable>
    <stateVariable sendEvents="yes"><name>LastChange</name><dataType>string</dataType></stateVariable>
    <stateVariable sendEvents="no"><name>A_ARG_Str</name><dataType>string</dataType></stateVariable>
    <stateVariable sendEvents="no"><name>A_ARG_UI4</name><dataType>ui4</dataType></stateVariable>
  </serviceStateTable>
</scpd>
